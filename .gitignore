# Ambienti e cache Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.playwright-cli/

# Configurazione locale e segreti
.env
.env.*
!.env.example

# Dati sanitari e file generati localmente
traces/
risultati/
uploads/
benchmarks/
graphify-out/
*_spiegato.txt

# Modelli locali (non devono finire nel repository)
models/
*.gguf
*.safetensors

# Sistema operativo ed editor
.DS_Store
.idea/
.vscode/

# Parole del glossario incontrate nei referti analizzati (dato locale)
glossario/parole_salvate.json
glossario/*.tmp

# Risposte di OpenStreetMap salvate per la mappa delle strutture
strutture_cache/

# Foglietti illustrativi AIFA scaricati alla prima consultazione
farmaci_cache/

# Obsidian: nel repo solo la configurazione del grafo
docs/.obsidian/*
!docs/.obsidian/graph.json
!docs/.obsidian/app.json

# Profilo del paziente (città): dato personale, resta su questo computer
profilo/

# Schede farmaci generate dagli open data AIFA (evolus/costruisci_schede_farmaci.py)
evolus/farmaci/*
!evolus/farmaci/.gitkeep

